# Copy to ~/Library/Application Support/Claude A-B GSB Console/config.env
# The installer creates this file automatically and never overwrites it.
PAIRWISE_GITHUB_OWNER=your-github-login
PAIRWISE_GIT_AUTHOR_NAME=刘昱
PAIRWISE_GIT_AUTHOR_EMAIL=your-github-noreply-email
PAIRWISE_GITHUB_VISIBILITY=public
PAIRWISE_CLAUDE_BASE_IMAGE=claude-eval-runtime:claude-2.1.269
PAIRWISE_CLAUDE_IMAGE=claude-eval-runtime:prepared-2.1.269
PAIRWISE_MAX_PARALLEL=3
PAIRWISE_MAX_TERMINALS=3
PAIRWISE_TASK_GENERATION_PARALLEL=6
# Optional overrides:
# PAIRWISE_PORT=8865
# PAIRWISE_OLD_DB=/absolute/path/to/old/console.db
